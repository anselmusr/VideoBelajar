# Konfigurasi koneksi MySQL (host, username, password, port, database name)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=videobelajar
# MySQL cloud (Aiven dsb) wajib TLS: isi dengan isi file ca.pem dari dashboard.
# Penyedia dengan CA publik cukup DB_SSL=true. MySQL lokal: kosongkan keduanya.
# DB_SSL_CA=
# DB_SSL=false

# Port REST API Express
PORT=3001

# misi Backend Advance 1: secret untuk sign/verify JWT (ganti dengan nilai acak sendiri)
JWT_SECRET=ganti-dengan-random-hex
# Base URL tautan verifikasi email = origin FRONTEND (halaman /verify-email)
# Produksi: isi dengan domain Vercel, mis. https://videobelajar-xxx.vercel.app
APP_URL=http://localhost:5173
# SMTP opsional di dev — kosongkan untuk memakai akun uji Ethereal (preview URL
# muncul di log server). WAJIB diisi saat NODE_ENV=production.
# Contoh Brevo: host smtp-relay.brevo.com, port 587, user = login SMTP,
# pass = SMTP key (bukan password akun).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# Alamat pengirim; harus alamat yang sudah diverifikasi di penyedia SMTP
# MAIL_FROM="EduCourse VideoBelajar <kamu@domainmu.com>"
