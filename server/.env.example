# Konfigurasi koneksi MySQL (host, username, password, port, database name)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=videobelajar

# Port REST API Express
PORT=3001

# misi Backend Advance 1: secret untuk sign/verify JWT (ganti dengan nilai acak sendiri)
JWT_SECRET=ganti-dengan-random-hex
# Base URL tautan verifikasi email = origin FRONTEND (halaman /verify-email)
# Produksi: isi dengan domain Vercel, mis. https://videobelajar-xxx.vercel.app
APP_URL=http://localhost:5173
# SMTP opsional — kosongkan untuk memakai akun uji Ethereal (preview URL muncul di log server)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
